{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "userschema.json",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri"
        },
        "id": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20
        }
    },
    "required": ["id", "email"],
    "additionalProperties": false
}